 }
 .cv-container {
 max-width: 800px;
 margin: 0 auto;
 background: white;
 padding: 40px;
 box-shadow: 0 0 20px rgba(0,0,0,0.1);
 }
 .header {
 text-align: center;
 border-bottom: 3px solid #0cd4bd;
