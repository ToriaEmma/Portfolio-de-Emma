 padding-left: 20px;
 border-left: 3px solid #4f46e5;
 }
 .job-title {
 font-weight: bold;
 color: #333;
 font-size: 1.1em;
 }
 .company {
 color: #0cd4bd;
 font-weight: 600;
 }
 .date {
 color: #e91e63;
 font-style: italic;
 }
 .skills-grid {
 display: grid;
 grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
 gap: 15px;
 }
 .skill-category {
