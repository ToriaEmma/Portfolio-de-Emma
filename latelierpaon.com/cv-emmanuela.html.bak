 margin: 0 0 10px 0;
 }
 .skill-list {
 list-style: none;
 padding: 0;
 margin: 0;
 }
 .skill-list li {
 padding: 3px 0;
 color: #666;
 }
 .skill-list li:before {
 content: "▸ ";
 color: #e91e63;
 font-weight: bold;
 }
 </style>
</head>
